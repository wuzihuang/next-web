<div class="nb-account wrap">
  <h1>{{ 'customers.reset_title' | t }}</h1>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <label for="ResetPassword">{{ 'customers.password' | t }}</label>
    <input type="password" name="customer[password]" id="ResetPassword">
    <label for="ResetPasswordConfirm">{{ 'customers.password' | t }}</label>
    <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm">
    <button class="buy" type="submit">{{ 'customers.submit' | t }}</button>
  {% endform %}
</div>
