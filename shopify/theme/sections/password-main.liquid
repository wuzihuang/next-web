<main class="nb-password-main" id="MainContent">
  <p class="lp-wordmark-name">NEXTBODY</p>
  <span class="lp-pip" aria-hidden="true"></span>
  <h1>{{ 'password.title' | t }}</h1>
  <p>{{ 'password.lede' | t }}</p>
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <label class="visually-hidden" for="password">{{ 'password.title' | t }}</label>
    <input type="password" name="password" id="password" autocomplete="current-password">
    <button class="lp-pill" type="submit">{{ 'password.login' | t }}</button>
  {% endform %}
</main>
{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
