<section class="wrap nb-account">
  <h1>{{ 'customers.register' | t }}</h1>
  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <label for="RegisterFirstName">{{ 'customers.first_name' | t }}</label>
    <input id="RegisterFirstName" type="text" name="customer[first_name]" autocomplete="given-name">
    <label for="RegisterLastName">{{ 'customers.last_name' | t }}</label>
    <input id="RegisterLastName" type="text" name="customer[last_name]" autocomplete="family-name">
    <label for="RegisterEmail">{{ 'customers.email' | t }}</label>
    <input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required>
    <label for="RegisterPassword">{{ 'customers.password' | t }}</label>
    <input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password">
    <button class="buy" type="submit">{{ 'customers.submit' | t }}</button>
  {% endform %}
</section>
