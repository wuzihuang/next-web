<section class="wrap nb-account">
  <h1>{{ 'customers.account' | t }}</h1>
  <p>{{ customer.name }} · {{ customer.email }}</p>
  <p><a href="{{ routes.account_logout_url }}">{{ 'customers.logout' | t }}</a></p>
  <h2>{{ 'customers.orders' | t }}</h2>
  {% if customer.orders.size == 0 %}
    <p>{{ 'cart.empty' | t }}</p>
  {% else %}
    <ul>
      {% for order in customer.orders %}
        <li>
          <a href="{{ order.customer_url }}">{{ 'customers.order' | t: name: order.name }}</a>
          {{ order.created_at | date: '%Y-%m-%d' }}
          {{ order.total_price | money }}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
  <p><a href="{{ routes.account_addresses_url }}">{{ 'customers.addresses' | t }}</a></p>
</section>
