{% liquid
  assign locale_code = request.locale.iso_code | downcase
  if locale_code contains 'zh'
    assign nav_locale = 'zh'
  else
    assign nav_locale = 'en'
  endif
%}
<div class="lp lp-hero-page" data-locale="{{ nav_locale }}">
  <div class="lp-shell"><div id="nb-hero" class="nb-hero"></div></div>
</div>

{% schema %}
{
  "name": "Landing hero",
  "settings": [],
  "presets": [{ "name": "Landing hero" }]
}
{% endschema %}
