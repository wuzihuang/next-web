<section class="nb-password">
  <div class="panel">
    <p class="eyebrow">NEXTBODY</p>
    <h1>{{ shop.name }}</h1>
    <p class="lede">{{ 'password.lede' | t }}</p>
    {% form 'storefront_password', class: 'nb-password-form' %}
      {% if form.errors %}
        <p class="nb-product-status" role="alert">{{ 'password.error' | t }}</p>
      {% endif %}
      <label class="visually-hidden" for="Password">{{ 'password.title' | t }}</label>
      <input id="Password" type="password" name="password" autocomplete="current-password">
      <button class="buy" type="submit">{{ 'password.submit' | t }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
